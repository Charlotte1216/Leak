{
  "training": {
    "num_episodes": 8000,
    "max_steps_per_episode": 1000,
    "save_interval": 100,
    "log_interval": 10,
    "pretrained_dir": "",
    "eval_interval": 50
  },
  "marl": {
    "algorithm": "mappo",
    "mappo": {
      "gamma": 0.9,
      "gae_lambda": 0.95
    },
    "qmix": {
      "gamma": 0.99,
      "mixer_lr": "3e-4",
      "tau": 0.005,
      "global_state_dim": 8
    }
  },
  "environment": {
    "num_agents": 4,
    "action_dim": 8,
    "source_find_radius": 5.0,
    "collision_penalty": 1.0,
    "battery_penalty": 0.001,
    "found_source_bonus": 20.0,
    "done_bonus": 0.0,
    "success_done_bonus": 120.0,
    "failure_done_penalty": 5.0,
    "enable_collision": true,
    "stop_on_collision": false,
    "observe_wind": true,
    "observe_velocity": true,
    "distance_reward_scale": 6,
    "found_source_concentration_scale": 0.05,
    "found_source_stay_penalty": 0.15,
    "found_source_stay_radius_scale": 1.5,
    "communication": {
      "enabled": true,
      "top_k": 2,
      "radius": 0.0,
      "include_concentration": true,
      "include_battery": true,
      "include_velocity": false,
      "normalize_relative": true
    },
    "uav_params": {
      "max_speed": 5.0,
      "max_acceleration": 1.0,
      "max_battery": 150.0,
      "energy_consumption_rate": 0.07,
      "dt": 1.0
    },
    "init_pos_mode": "random",
    "dynamic_field": {
      "enabled": true,
      "dt": 1.0,
      "keep_plume_behind_obstacle": true,
      "wind": {
        "enabled": true,
        "speed_amplitude": 0.0,
        "speed_frequency": 0.0,
        "speed_phase": 0.0,
        "dir_amplitude": 0.0,
        "dir_frequency": 0.0,
        "dir_phase": 0.0
      },
      "vortex": {
        "use_strouhal": true,
        "strouhal": 0.2,
        "min_wind_speed": 0.001,
        "min_diameter": 0.001
      }
    },
    "state_dim": 4
  },
  "agent": {
    "algorithm": "ppo",
    "network_type": "ffnn",
    "learning": {
      "lr": 0.0001,
      "gamma": 0.9,
      "batch_size": 64,
      "dqn": {
        "epsilon": 1.0,
        "epsilon_min": 0.01,
        "epsilon_decay": 0.995,
        "tau": 0.005,
        "replay_buffer_size": 10000
      },
      "ppo": {
        "clip": 0.2,
        "epochs": 4,
        "value_coef": 0.5,
        "entropy_coef": 0.003,
        "aux": {
          "enabled": false,
          "weight": 0.0,
          "target_index": 2,
          "hidden_dim": 128
        },
        "lstm_training": {
          "enabled": true,
          "seq_len": 16,
          "stride": 4
        }
      }
    },
    "device": "cuda",
    "network": {
      "type": "ffnn",
      "hidden_dims": [
        128,
        128
      ],
      "activation": "relu",
      "lstm": {
        "hidden_dim": 128,
        "lstm_hidden_dim": 64,
        "num_layers": 1
      },
      "transformer": {
        "hidden_dim": 128,
        "num_heads": 4,
        "num_layers": 2,
        "seq_len": 10
      }
    }
  },
  "output": {
    "save_dir": "./checkpoints",
    "log_dir": "./logs",
    "tensorboard_dir": "./runs"
  },
  "seed": 1024
}