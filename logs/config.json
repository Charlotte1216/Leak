{
  "training": {
    "num_episodes": 5000,
    "max_steps_per_episode": 1000,
    "save_interval": 100,
    "log_interval": 10,
    "pretrained_dir": "",
    "eval_interval": 50
  },
  "marl": {
    "algorithm": "mappo",
    "mappo": {
      "gamma": 0.9,
      "gae_lambda": 0.95
    },
    "qmix": {
      "gamma": 0.99,
      "mixer_lr": "3e-4",
      "tau": 0.005,
      "global_state_dim": 8
    }
  },
  "environment": {
    "num_agents": 2,
    "action_dim": 8,
    "source_find_radius": 5.0,
    "collision_penalty": 1.0,
    "battery_penalty": 0.001,
    "found_source_bonus": 20.0,
    "done_bonus": 0.0,
    "success_done_bonus": 30.0,
    "failure_done_penalty": 5.0,
    "enable_collision": true,
    "stop_on_collision": false,
    "observe_wind": true,
    "distance_reward_scale": 1,
    "init_pos_mode": "random",
    "state_dim": 4
  },
  "agent": {
    "algorithm": "ppo",
    "network_type": "ffnn",
    "learning": {
      "lr": 0.0001,
      "gamma": 0.9,
      "batch_size": 64,
      "dqn": {
        "epsilon": 1.0,
        "epsilon_min": 0.01,
        "epsilon_decay": 0.995,
        "tau": 0.005,
        "replay_buffer_size": 10000
      },
      "ppo": {
        "clip": 0.2,
        "epochs": 4,
        "value_coef": 0.5,
        "entropy_coef": 0.01
      }
    },
    "device": "cuda",
    "network": {
      "type": "lstm",
      "hidden_dims": [
        128,
        128
      ],
      "activation": "relu",
      "lstm": {
        "hidden_dim": 128,
        "lstm_hidden_dim": 64,
        "num_layers": 1
      },
      "transformer": {
        "hidden_dim": 128,
        "num_heads": 4,
        "num_layers": 2,
        "seq_len": 10
      }
    }
  },
  "output": {
    "save_dir": "./checkpoints",
    "log_dir": "./logs",
    "tensorboard_dir": "./runs"
  },
  "seed": 42
}